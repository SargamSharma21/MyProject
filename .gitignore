.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# 2. Python & FastAPI Backend
# ==========================================
# Virtual environments
myenv/
venv/
.venv/
env/
ENV/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
