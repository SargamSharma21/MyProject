*.egg

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/

# Local static uploads (Never commit user medical slips / uploaded images)
backend/uploads/
backend/uploads/prescriptions/*
!backend/uploads/prescriptions/.gitkeep
uploads/

# ==========================================
# 3. Node.js & React Native / Expo Frontend
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Expo build artifacts & cache
.expo/
.expo-shared/
dist/
web-build/

# Native build output (if you ever run expo prebuild / run:ios / run:android)
frontend/ios/
frontend/android/

# Metro bundler cache
.metro-health-check*

